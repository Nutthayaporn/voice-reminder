# Copy to `.env`, then fill in. Expo inlines only EXPO_PUBLIC_* vars into the
# app bundle. Restart the dev server after editing (env is read at bundle time).

# Groq API key — powers cloud STT (Whisper) and, later, the intent LLM.
# Free key: https://console.groq.com/keys
# WARNING: an EXPO_PUBLIC_ key ships inside the app. Fine for personal/dev use;
# move the Groq call behind a Supabase Edge Function before any public release.
EXPO_PUBLIC_GROQ_API_KEY=

# Supabase — optional account backup/sync for reminders/events/todos/notes.
# Apply supabase/migrations/20260831000000_items_sync.sql, enable Email/Password,
# and configure Google/Facebook providers as needed; see supabase/README.md.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Daily Budget bridge — the `budget-api` Edge Function in the sibling
# daily-budget project. Enables voice budget questions ("เหลือใช้ได้กี่บาท"),
# and logging/editing expenses without leaving the app. Requires daily-budget
# cloud sync enabled + signed in.
#   URL: the budget-api endpoint (the oauth-token/oauth-revoke endpoints are
#   derived from it). Just set this and users connect their OWN account in-app
#   via OAuth (Settings → Connect Daily Budget). Leave unset to fall back to the
#   deep-link handoff (record only).
EXPO_PUBLIC_BUDGET_API_URL=
# OPTIONAL legacy single-user shared token. Leave EMPTY for multi-user OAuth.
# If set, it must match the VOICE_API_TOKEN secret on the budget-api function
# and maps to one preconfigured space (bypasses per-user connect).
EXPO_PUBLIC_BUDGET_API_TOKEN=
