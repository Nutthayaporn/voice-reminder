# Copy to `.env`, then fill in. Expo inlines only EXPO_PUBLIC_* vars into the
# app bundle. Restart the dev server after editing (env is read at bundle time).

# Groq API key — powers cloud STT (Whisper) and, later, the intent LLM.
# Free key: https://console.groq.com/keys
# WARNING: an EXPO_PUBLIC_ key ships inside the app. Fine for personal/dev use;
# move the Groq call behind a Supabase Edge Function before any public release.
EXPO_PUBLIC_GROQ_API_KEY=

# Supabase (Phase 2 — persistence for reminders/events/notes)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
