{
  "expo": {
    "name": "VORA",
    "slug": "voice-reminder",
    "scheme": "voicereminder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spyrocash.voicereminder",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "LSApplicationQueriesSchemes": [
          "dailybudget"
        ],
        "NSAlarmKitUsageDescription": "ใช้เพื่อตั้งนาฬิกาปลุกตามเวลาที่คุณสั่งและให้คุณหยุดหรือเลื่อนปลุกได้",
        "NSSpeechRecognitionUsageDescription": "ใช้เพื่อถอดเสียงพูดของคุณเป็นข้อความในเครื่อง",
        "NSMicrophoneUsageDescription": "ใช้ไมโครโฟนเพื่อฟังคำสั่งเสียง"
      }
    },
    "android": {
      "package": "com.spyrocash.voicereminder",
      "adaptiveIcon": {
        "backgroundColor": "#02070C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "themeColor": "#02070C",
      "backgroundColor": "#02070C"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "ใช้ไมโครโฟนเพื่อฟังคำสั่งเสียงและบันทึกรายการให้คุณ"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "ใช้ไมโครโฟนเพื่อฟังคำสั่งเสียง",
          "speechRecognitionPermission": "ใช้เพื่อถอดเสียงพูดของคุณเป็นข้อความในเครื่อง",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#38BDF8"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "237e599b-ec3e-46b8-9a5b-76d6c803c0b4"
      }
    }
  }
}
